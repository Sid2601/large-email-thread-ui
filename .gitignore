# Dependencies
node_modules/

# Build output
dist/
dist-dev/

# Local-only Claude settings (machine-specific)
.claude/

# Auto-generated by Stop hook — local runner state, not useful to commit
*.md
.claude/runner.log

# OS
.DS_Store

# Env
.env
.env.local

# Keep project reference documents under version control.
!README.md
!CONTEXT.md
# The architecture reference is part of the product, not local runner state.
!architecture/**/*.md

# Generated local distribution archive
releases/
!TEST_COVERAGE.md

# Synthetic package smoke output, including diagnostic capture files
artifacts/packages-*/
