{
  "name": "threadlens",
  "version": "1.7.3",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "npm run build:prod",
    "typecheck": "tsc --noEmit",
    "version:patch": "npm version patch --no-git-tag-version",
    "version:minor": "npm version minor --no-git-tag-version",
    "version:major": "npm version major --no-git-tag-version",
    "test": "vitest run",
    "test:watch": "vitest",
    "replay": "node scripts/replay-capture.mjs",
    "icons": "node scripts/generate-icons.js",
    "release": "npm run release:prod",
    "package": "npm run package:prod",
    "build:dev": "vite build --mode development",
    "build:prod": "vite build --mode production",
    "release:dev": "node scripts/release.mjs --dev",
    "release:prod": "node scripts/release.mjs --prod",
    "package:dev": "npm run release:dev",
    "package:prod": "npm run release:prod",
    "test:packages": "node scripts/smoke-packages.mjs"
  },
  "dependencies": {
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.23",
    "@types/chrome": "^0.0.268",
    "@types/node": "^25.6.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.19",
    "jsdom": "^27.0.1",
    "postcss": "^8.4.38",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.4",
    "type-fest": "^5.6.0",
    "typescript": "^5.5.0",
    "vite": "^5.3.0",
    "vitest": "^4.1.5"
  }
}
